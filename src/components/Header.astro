---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeSwitcher from './ThemeSwitcher.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/ai-bot">AI Bot</HeaderLink>
			<HeaderLink href="/idea" class="auth-only">Idea</HeaderLink>
			<HeaderLink href="/collection" class="auth-only">Collection</HeaderLink>
			<HeaderLink href="/gallery-firebase" class="auth-only">Gallery</HeaderLink>
			<HeaderLink href="/apps" class="auth-only">Apps</HeaderLink>
			<HeaderLink href="/playground" class="auth-only">Playgrounds</HeaderLink>
			<HeaderLink href="/api-docs" class="auth-only">API Docs</HeaderLink>
			<HeaderLink href="/md-browser" class="auth-only">MD Browser</HeaderLink>
			<a href="/my-assets" class="my-assets-link auth-only">My assets</a>
			<HeaderLink href="/public" class="auth-only">Public</HeaderLink>
			<HeaderLink href="/about" class="auth-only">About</HeaderLink>
			<HeaderLink href="/admin" class="auth-only">Dashboard</HeaderLink>
			<HeaderLink href="/login" class="auth-only">Login</HeaderLink>
		</div>
		<div class="header-right">
			<ThemeSwitcher />
			<a href="/login" class="login-icon-link" aria-label="Login">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22">
					<path
						fill="currentColor"
						d="M12 12c2.761 0 5-2.239 5-5S14.761 2 12 2 7 4.239 7 7s2.239 5 5 5zm0 2c-3.866 0-7 3.134-7 7v1h14v-1c0-3.866-3.134-7-7-7z"
					/>
				</svg>
			</a>
		</div>
	</nav>
	<script>
		const DASHBOARD_ACCESS_KEY = 'dashboardAccess';
		const MY_ASSETS_ACCESS_KEY = 'myAssetsAccess';
		const MY_ASSETS_PASSWORD = '1111';

		function syncAuthVisibility() {
			const hasAccess = typeof window !== 'undefined'
				&& window.localStorage.getItem(DASHBOARD_ACCESS_KEY) === 'true';
			const headerEl = document.querySelector('header');
			if (!headerEl) return;
			headerEl.dataset.auth = hasAccess ? 'true' : 'false';
		}

		if (typeof window !== 'undefined') {
			// Initial sync
			syncAuthVisibility();

			const myAssetsLink = document.querySelector('.my-assets-link') as HTMLAnchorElement | null;
			const myAssetsDialog = document.getElementById('my-assets-dialog') as HTMLDialogElement | null;
			const myAssetsForm = document.getElementById('my-assets-form') as HTMLFormElement | null;
			const myAssetsInput = document.getElementById('my-assets-password') as HTMLInputElement | null;
			const myAssetsError = document.getElementById('my-assets-error') as HTMLParagraphElement | null;
			let pendingMyAssetsHref: string | null = null;

			function hasMyAssetsAccess() {
				return window.localStorage.getItem(MY_ASSETS_ACCESS_KEY) === 'true';
			}

			function openMyAssetsDialog(href: string) {
				pendingMyAssetsHref = href;
				if (myAssetsError) myAssetsError.textContent = '';
				if (myAssetsInput) myAssetsInput.value = '';
				myAssetsDialog?.showModal();
				setTimeout(() => myAssetsInput?.focus(), 0);
			}

			myAssetsLink?.addEventListener('click', (event) => {
				if (hasMyAssetsAccess()) return;
				event.preventDefault();
				openMyAssetsDialog(myAssetsLink.href);
			});

			myAssetsForm?.addEventListener('submit', (event) => {
				event.preventDefault();
				const value = (myAssetsInput?.value || '').trim();
				if (value !== MY_ASSETS_PASSWORD) {
					if (myAssetsError) myAssetsError.textContent = 'Wrong password';
					myAssetsInput?.focus();
					return;
				}
				window.localStorage.setItem(MY_ASSETS_ACCESS_KEY, 'true');
				myAssetsDialog?.close();
				if (pendingMyAssetsHref) window.location.href = pendingMyAssetsHref;
			});

			myAssetsDialog?.addEventListener('close', () => {
				pendingMyAssetsHref = null;
			});

			// React to storage changes (e.g. login/logout in other tabs)
			window.addEventListener('storage', (event) => {
				if (event.key === DASHBOARD_ACCESS_KEY) {
					syncAuthVisibility();
				}
			});
		}
	</script>
</header>

<dialog id="my-assets-dialog" class="my-assets-dialog">
	<form id="my-assets-form" method="dialog" class="my-assets-form">
		<h3>My assets</h3>
		<p class="my-assets-subtitle">Enter password to continue.</p>
		<input
			id="my-assets-password"
			type="password"
			inputmode="numeric"
			autocomplete="one-time-code"
			placeholder="Password"
		/>
		<p id="my-assets-error" class="my-assets-error" aria-live="polite"></p>
		<div class="my-assets-actions">
			<button type="button" class="my-assets-cancel" onclick="document.getElementById('my-assets-dialog')?.close()">Cancel</button>
			<button type="submit" class="my-assets-submit">Continue</button>
		</div>
	</form>
</dialog>
<style>
header {
	margin: 0;
	padding: 0 1em;
	background: var(--bg-primary);
	box-shadow: 0 2px 8px rgba(var(--black), 5%);
	transition: background-color 0.3s ease;
}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--text-primary);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		transition: color 0.3s ease;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.header-right {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	header[data-auth='false'] .auth-only {
		display: none;
	}
	header[data-auth='true'] .auth-only {
		display: inline-block;
	}
	.login-icon-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.55rem;
		border-radius: 999px;
		border: 1px solid transparent;
		color: var(--text-primary);
		text-decoration: none;
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}
	.login-icon-link:hover {
		background: var(--bg-secondary);
		border-color: var(--border-color);
	}
	/* default (before JS runs): only Home + Blog visible */
	.auth-only {
		display: none;
	}

	.my-assets-dialog {
		border: 1px solid var(--border-color);
		border-radius: 14px;
		background: var(--bg-primary);
		color: var(--text-primary);
		padding: 0;
		max-width: 420px;
		width: calc(100% - 2rem);
	}
	.my-assets-dialog::backdrop {
		background: rgba(0, 0, 0, 0.5);
	}
	.my-assets-form {
		padding: 1.25rem;
		display: grid;
		gap: 0.75rem;
	}
	.my-assets-form h3 {
		margin: 0;
		font-size: 1.1rem;
	}
	.my-assets-subtitle {
		margin: 0;
		color: rgb(var(--gray));
	}
	.my-assets-form input {
		padding: 0.75rem;
		border-radius: 10px;
		border: 1px solid var(--border-color);
		background: var(--bg-secondary);
		color: inherit;
	}
	.my-assets-error {
		margin: 0;
		min-height: 1.25rem;
		color: #d32f2f;
		font-weight: 600;
	}
	.my-assets-actions {
		display: flex;
		justify-content: flex-end;
		gap: 0.5rem;
	}
	.my-assets-cancel {
		padding: 0.6rem 0.9rem;
		border-radius: 999px;
		border: 1px solid var(--border-color);
		background: transparent;
		color: inherit;
		cursor: pointer;
	}
	.my-assets-submit {
		padding: 0.6rem 0.9rem;
		border-radius: 999px;
		border: none;
		background: rgb(var(--accent));
		color: white;
		font-weight: 700;
		cursor: pointer;
	}
</style>
