---
import AboutHeroImage from '../../assets/myavatar.jpg';
import CVPreview from '../CVPreview.astro';
import { SITE_AUTHOR, SITE_TITLE } from '../../consts';

const skills = ['Astro / React', 'UI system design', 'DX & Automation', 'Web fundamentals'];
---

<div class="neu-page about-neu">
	<div class="about-neu__orbs" aria-hidden="true">
		<span class="orb orb--1"></span>
		<span class="orb orb--2"></span>
	</div>
	<div class="about-neu__watermark" aria-hidden="true">{SITE_TITLE}</div>

	<div class="about-neu__inner">
		<section class="about-neu__hero">
			<div class="about-neu__intro neu-raised">
				<p class="about-neu__eyebrow">About</p>
				<h1>Hello, I'm {SITE_AUTHOR}</h1>
				<p class="about-neu__lead">
					I am a frontend engineer, focused on DX, performance and user experience. This blog is where I document my learning process, experiments and lessons when building real products.
				</p>
				<div class="about-neu__pills">
					{skills.map((skill) => (
						<span class="about-neu__pill neu-inset-sm">{skill}</span>
					))}
				</div>
				<div class="about-neu__actions">
					<a
						href="https://docs.google.com/document/d/1n1hOc4GJMTRVARpyqjtM6gbWcEyiSmVx/edit?usp=sharing&ouid=110303296683149389854&rtpof=true&sd=true"
						target="_blank"
						rel="noreferrer"
						class="neu-pill neu-pill--primary"
					>
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
							<polyline points="14 2 14 8 20 8"></polyline>
						</svg>
						View CV
					</a>
					<button type="button" class="neu-pill" onclick="window.openCVPreview?.()">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
							<circle cx="12" cy="12" r="3"></circle>
						</svg>
						Preview CV
					</button>
					<a href="/blog" class="neu-pill">Read blog</a>
				</div>
			</div>

			<aside class="about-neu__profile neu-raised">
				<div class="about-neu__avatar-wrap neu-inset-sm">
					<img src={AboutHeroImage.src} alt="Avatar" loading="lazy" width="320" height="320" />
				</div>
				<ul class="about-neu__meta">
					<li><span>Role</span><strong>Frontend engineer</strong></li>
					<li><span>Currently</span><strong>Building products, mentoring dev team</strong></li>
					<li><span>Interests</span><strong>Writing blog, reading books, optimizing workflow</strong></li>
				</ul>
			</aside>
		</section>

		<section class="about-neu__section neu-raised">
			<h2>Work philosophy</h2>
			<p>
				I believe good products need solid technical foundations and clear processes. Every article aims to simplify knowledge, with real examples and can be applied immediately in projects.
			</p>
			<ul class="about-neu__list">
				<li>Prioritize clarity over cleverness.</li>
				<li>Build component systems to scale quickly but still maintain control.</li>
				<li>Automate repetitive tasks so dev teams can focus on core value.</li>
			</ul>
		</section>

		<section class="about-neu__section neu-raised">
			<h2>What am I working on?</h2>
			<ul class="about-neu__list">
				<li>Completing Astro starter kit for personal blog.</li>
				<li>Writing short series on bundler optimization and DX for frontend.</li>
				<li>Mentoring on clear code writing, code review and UI API design.</li>
			</ul>
		</section>
	</div>

	<CVPreview />
</div>

<style>
	@import '../../styles/neu-tokens.css';

	.about-neu {
		position: relative;
		min-height: calc(100vh - 7rem);
		padding: 2.5rem clamp(1rem, 4vw, 2.5rem) 4rem;
		overflow: hidden;
	}

	.about-neu__orbs {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.orb {
		position: absolute;
		border-radius: 50%;
		filter: blur(70px);
		opacity: 0.4;
	}
	.orb--1 {
		width: 280px;
		height: 280px;
		background: #93c5fd;
		top: -60px;
		right: 5%;
	}
	.orb--2 {
		width: 240px;
		height: 240px;
		background: #c4b5fd;
		bottom: 15%;
		left: -50px;
	}

	.about-neu__watermark {
		position: absolute;
		top: 38%;
		left: 50%;
		transform: translate(-50%, -50%);
		font-size: clamp(3.5rem, 16vw, 10rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		color: rgba(163, 177, 198, 0.16);
		white-space: nowrap;
		pointer-events: none;
		user-select: none;
	}
	:global(:root.dark) .about-neu__watermark {
		color: rgba(255, 255, 255, 0.03);
	}

	.about-neu__inner {
		position: relative;
		z-index: 1;
		max-width: 960px;
		margin: 0 auto;
		display: grid;
		gap: 1.5rem;
	}

	.about-neu__hero {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: 1.5rem;
		align-items: start;
	}

	.about-neu__intro,
	.about-neu__profile,
	.about-neu__section {
		padding: 2rem;
	}

	.about-neu__eyebrow {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--neu-muted);
	}

	.about-neu__intro h1 {
		margin: 0.35rem 0 0.75rem;
		font-size: clamp(1.85rem, 4vw, 2.5rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--neu-text);
	}

	.about-neu__lead {
		margin: 0;
		color: var(--neu-muted);
		line-height: 1.65;
		font-size: 1.05rem;
	}

	.about-neu__pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-top: 1.25rem;
	}

	.neu-inset-sm {
		background: var(--neu-surface);
		border-radius: 999px;
		box-shadow:
			inset 3px 3px 8px var(--neu-dark),
			inset -3px -3px 8px var(--neu-light);
	}

	.about-neu__pill {
		padding: 0.45rem 0.9rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--neu-text);
	}

	.about-neu__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}

	.about-neu__profile {
		display: grid;
		gap: 1.25rem;
	}

	.about-neu__avatar-wrap {
		padding: 0.5rem;
		border-radius: 1.25rem;
		overflow: hidden;
	}

	.about-neu__avatar-wrap img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 1rem;
	}

	.about-neu__meta {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.85rem;
	}

	.about-neu__meta li {
		display: grid;
		gap: 0.15rem;
		padding: 0.65rem 0.85rem;
		border-radius: 0.85rem;
		background: var(--neu-surface);
		box-shadow:
			inset 3px 3px 8px var(--neu-dark),
			inset -3px -3px 8px var(--neu-light);
	}

	.about-neu__meta span {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--neu-muted);
		font-weight: 600;
	}

	.about-neu__meta strong {
		font-size: 0.92rem;
		color: var(--neu-text);
		font-weight: 600;
		line-height: 1.4;
	}

	.about-neu__section h2 {
		margin: 0 0 0.75rem;
		font-size: 1.35rem;
		font-weight: 700;
		color: var(--neu-text);
		letter-spacing: -0.02em;
	}

	.about-neu__section p {
		margin: 0 0 1rem;
		color: var(--neu-muted);
		line-height: 1.65;
	}

	.about-neu__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.55rem;
	}

	.about-neu__list li {
		position: relative;
		padding: 0.65rem 1rem 0.65rem 1.75rem;
		color: var(--neu-text);
		font-size: 0.95rem;
		border-radius: 0.75rem;
		background: var(--neu-surface);
		box-shadow:
			inset 2px 2px 6px var(--neu-dark),
			inset -2px -2px 6px var(--neu-light);
	}

	.about-neu__list li::before {
		content: '';
		position: absolute;
		left: 0.75rem;
		top: 50%;
		transform: translateY(-50%);
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
	}

	/* CV modal — match neumorphic when open on this page */
	:global(body:has(.about-neu) .cv-modal-overlay) {
		backdrop-filter: blur(8px);
	}
	:global(body:has(.about-neu) .cv-modal-content) {
		border-radius: 1.5rem;
		border: 1px solid rgba(255, 255, 255, 0.4);
		box-shadow:
			16px 16px 32px #b8c5d9,
			-16px -16px 32px #ffffff;
	}
	:global(:root.dark body:has(.about-neu) .cv-modal-content) {
		box-shadow:
			16px 16px 32px #0c1018,
			-16px -16px 32px #243044;
	}

	@media (max-width: 820px) {
		.about-neu__hero {
			grid-template-columns: 1fr;
		}
		.about-neu__profile {
			order: -1;
		}
	}

	@media (max-width: 520px) {
		.about-neu__intro,
		.about-neu__profile,
		.about-neu__section {
			padding: 1.35rem;
		}
	}
</style>
