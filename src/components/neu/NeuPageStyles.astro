---
/** Shared neumorphic page chrome (background, header, footer). Add class `neu-page` on a root wrapper. */
---

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

	body:has(.neu-page) {
		background: #e4eaf3 !important;
		background-image: none !important;
		font-family: 'Inter', system-ui, sans-serif;
	}

	:root.dark body:has(.neu-page) {
		background: #141a24 !important;
	}

	body:has(.neu-page) header {
		padding: 0.85rem 1.25rem;
		background: rgba(232, 237, 244, 0.75);
		backdrop-filter: blur(12px);
		box-shadow:
			0 4px 16px rgba(163, 177, 198, 0.2),
			inset 0 -1px 0 rgba(255, 255, 255, 0.6);
		border-bottom: none;
	}

	body:has(.neu-page) header nav {
		min-height: 2.75rem;
		align-items: center;
	}

	:root.dark body:has(.neu-page) header {
		background: rgba(20, 26, 36, 0.85);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
	}

	/* Nav links only — not theme/login controls */
	body:has(.neu-page) header nav .internal-links {
		display: flex;
		align-items: center;
		gap: 0.15rem;
	}

	body:has(.neu-page) header nav .internal-links a,
	body:has(.neu-page) header nav h2 a {
		border-bottom: none !important;
		text-decoration: none !important;
		border-radius: 999px;
		padding: 0.55rem 0.9rem;
		line-height: 1.25;
		display: inline-flex;
		align-items: center;
		transition: box-shadow 0.15s ease, background 0.15s ease, color 0.15s ease;
	}

	body:has(.neu-page) .header-right {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		align-self: center;
	}

	body:has(.neu-page) header nav .internal-links a.active {
		background: #e8edf4;
		box-shadow:
			inset 3px 3px 8px #b8c3d6,
			inset -3px -3px 8px #ffffff;
		color: var(--accent);
		font-weight: 600;
	}

	:root.dark body:has(.neu-page) header nav .internal-links a.active {
		background: #1a2230;
		box-shadow:
			inset 3px 3px 8px #0c1018,
			inset -3px -3px 8px #243044;
	}

	body:has(.neu-page) header h2 a {
		font-weight: 800;
		letter-spacing: -0.02em;
	}

	/* Theme + login: single clean circle, no double wrapper */
	body:has(.neu-page) .header-right .theme-switcher {
		margin-left: 0;
		padding: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
	}

	body:has(.neu-page) .header-right .theme-button,
	body:has(.neu-page) .header-right .login-icon-link {
		width: 40px;
		height: 40px;
		padding: 0;
		border-radius: 50%;
		border: none;
		background: #e8edf4;
		box-shadow:
			4px 4px 10px #b8c3d6,
			-4px -4px 10px #ffffff;
	}

	body:has(.neu-page) .header-right .theme-button:hover,
	body:has(.neu-page) .header-right .login-icon-link:hover {
		background: #e8edf4;
		border: none;
		box-shadow:
			5px 5px 12px #b8c3d6,
			-5px -5px 12px #ffffff;
	}

	:root.dark body:has(.neu-page) .header-right .theme-button,
	:root.dark body:has(.neu-page) .header-right .login-icon-link {
		background: #1a2230;
		box-shadow:
			4px 4px 10px #0c1018,
			-4px -4px 10px #243044;
	}

	:root.dark body:has(.neu-page) .header-right .theme-button:hover,
	:root.dark body:has(.neu-page) .header-right .login-icon-link:hover {
		background: #1a2230;
	}

	body:has(.neu-page) footer {
		background: transparent;
		background-image: none;
		padding-bottom: 2rem;
	}

	body:has(.neu-page) footer .social-links a {
		border-radius: 50%;
		padding: 0.5rem;
		background: #e8edf4;
		box-shadow:
			6px 6px 14px #b8c3d6,
			-6px -6px 14px #ffffff;
		transition: transform 0.15s ease;
	}

	body:has(.neu-page) footer .social-links a:hover {
		transform: translateY(-2px);
	}

	:root.dark body:has(.neu-page) footer .social-links a {
		background: #1a2230;
		box-shadow:
			6px 6px 14px #0c1018,
			-6px -6px 14px #243044;
	}

	body:has(.neu-page) .page {
		width: 100%;
		max-width: none;
		padding: 0;
	}
</style>
