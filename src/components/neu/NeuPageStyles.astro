---
/** Shared neumorphic page chrome (background, header, footer). Add class `neu-page` on a root wrapper. */
---

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

	body:has(.neu-page) {
		background: #e4eaf3 !important;
		background-image: none !important;
		font-family: 'Inter', system-ui, sans-serif;
	}

	:root.dark body:has(.neu-page) {
		background: #141a24 !important;
	}

	body:has(.neu-page) header {
		background: rgba(232, 237, 244, 0.75);
		backdrop-filter: blur(12px);
		box-shadow:
			0 4px 16px rgba(163, 177, 198, 0.2),
			inset 0 -1px 0 rgba(255, 255, 255, 0.6);
		border-bottom: none;
	}

	:root.dark body:has(.neu-page) header {
		background: rgba(20, 26, 36, 0.85);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
	}

	body:has(.neu-page) header nav a {
		border-bottom: none;
		border-radius: 999px;
		padding: 0.5em 0.85em;
		transition: box-shadow 0.15s ease, background 0.15s ease;
	}

	body:has(.neu-page) header nav a.active {
		background: #e8edf4;
		box-shadow:
			inset 3px 3px 8px #b8c3d6,
			inset -3px -3px 8px #ffffff;
		color: var(--accent);
	}

	:root.dark body:has(.neu-page) header nav a.active {
		background: #1a2230;
		box-shadow:
			inset 3px 3px 8px #0c1018,
			inset -3px -3px 8px #243044;
	}

	body:has(.neu-page) header h2 a {
		font-weight: 800;
		letter-spacing: -0.02em;
	}

	body:has(.neu-page) .header-right .theme-switcher,
	body:has(.neu-page) .social-links a {
		border-radius: 50%;
		padding: 0.35rem;
		box-shadow:
			4px 4px 10px #b8c3d6,
			-4px -4px 10px #ffffff;
		background: #e8edf4;
	}

	:root.dark body:has(.neu-page) .header-right .theme-switcher,
	:root.dark body:has(.neu-page) .social-links a {
		background: #1a2230;
		box-shadow:
			4px 4px 10px #0c1018,
			-4px -4px 10px #243044;
	}

	body:has(.neu-page) footer {
		background: transparent;
		background-image: none;
		padding-bottom: 2rem;
	}

	body:has(.neu-page) footer .social-links a {
		border-radius: 50%;
		padding: 0.5rem;
		background: #e8edf4;
		box-shadow:
			6px 6px 14px #b8c3d6,
			-6px -6px 14px #ffffff;
		transition: transform 0.15s ease;
	}

	body:has(.neu-page) footer .social-links a:hover {
		transform: translateY(-2px);
	}

	:root.dark body:has(.neu-page) footer .social-links a {
		background: #1a2230;
		box-shadow:
			6px 6px 14px #0c1018,
			-6px -6px 14px #243044;
	}

	body:has(.neu-page) .page {
		width: 100%;
		max-width: none;
		padding: 0;
	}
</style>
