---
import { SITE_TITLE } from '../../consts';

interface Props {
	postCount: number;
	htmlCount: number;
}

const { postCount, htmlCount } = Astro.props;
const total = postCount + htmlCount;
---

<div class="neu-page blog-neu">
	<div class="blog-neu__orbs" aria-hidden="true">
		<span class="orb orb--1"></span>
		<span class="orb orb--2"></span>
	</div>
	<div class="blog-neu__watermark" aria-hidden="true">{SITE_TITLE}</div>

	<div class="blog-neu__inner">
		<header class="blog-neu__header neu-raised">
			<div>
				<p class="blog-neu__eyebrow">Blog</p>
				<h1>Blog của Thanktoanf</h1>
				<p class="blog-neu__lead">
					{total > 0
						? `${total} bài viết — ghi chép học tập, thử nghiệm và chia sẻ kinh nghiệm dev.`
						: 'Ghi chép học tập, thử nghiệm và chia sẻ kinh nghiệm dev.'}
				</p>
			</div>
			<button id="add-blog-button" class="blog-neu__add neu-pill neu-pill--accent" hidden>
				+ Add blog
			</button>
		</header>

		<slot />
	</div>
</div>

<style>
	@import '../../styles/neu-tokens.css';

	.blog-neu {
		position: relative;
		min-height: calc(100vh - 7rem);
		padding: 2.5rem clamp(1rem, 4vw, 2.5rem) 4rem;
		overflow: hidden;
	}

	.blog-neu__orbs {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.orb {
		position: absolute;
		border-radius: 50%;
		filter: blur(70px);
		opacity: 0.4;
	}
	.orb--1 {
		width: 300px;
		height: 300px;
		background: #93c5fd;
		top: -50px;
		left: 10%;
	}
	.orb--2 {
		width: 260px;
		height: 260px;
		background: #fda4af;
		bottom: 10%;
		right: -40px;
		opacity: 0.35;
	}

	.blog-neu__watermark {
		position: absolute;
		top: 32%;
		left: 50%;
		transform: translate(-50%, -50%);
		font-size: clamp(3.5rem, 16vw, 10rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		color: rgba(163, 177, 198, 0.14);
		white-space: nowrap;
		pointer-events: none;
		user-select: none;
	}
	:global(:root.dark) .blog-neu__watermark {
		color: rgba(255, 255, 255, 0.03);
	}

	.blog-neu__inner {
		position: relative;
		z-index: 1;
		max-width: 1080px;
		margin: 0 auto;
		display: grid;
		gap: 1.75rem;
	}

	.blog-neu__header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.25rem;
		padding: 2rem 2.25rem;
	}

	.blog-neu__eyebrow {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--neu-muted);
	}

	.blog-neu__header h1 {
		margin: 0.35rem 0 0.5rem;
		font-size: clamp(1.75rem, 4vw, 2.35rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--neu-text);
	}

	.blog-neu__lead {
		margin: 0;
		color: var(--neu-muted);
		font-size: 1rem;
		line-height: 1.55;
		max-width: 36rem;
	}

	.neu-pill--accent {
		flex-shrink: 0;
		align-self: flex-start;
		color: #fff;
		background: linear-gradient(145deg, #fb923c, #f97316);
		box-shadow:
			6px 6px 14px rgba(249, 115, 22, 0.35),
			-4px -4px 12px var(--neu-light);
	}
	.neu-pill--accent:hover {
		color: #fff;
	}

	/* Post grid */
	.blog-neu :global(.post-grid) {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.5rem;
	}

	/* Neumorphic cards (PostCard + HTML cards) */
	.blog-neu :global(.card) {
		background: var(--neu-surface);
		border-radius: 1.25rem;
		border: 1px solid rgba(255, 255, 255, 0.45);
		box-shadow:
			10px 10px 22px var(--neu-dark),
			-10px -10px 22px var(--neu-light);
		transition: transform 0.15s ease, box-shadow 0.15s ease;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		height: 400px;
	}

	.blog-neu :global(.card:hover) {
		transform: translateY(-4px);
		box-shadow:
			14px 14px 28px var(--neu-dark),
			-14px -14px 28px var(--neu-light);
	}

	.blog-neu :global(.card__link) {
		display: flex;
		flex-direction: column;
		height: 100%;
		color: inherit;
		text-decoration: none;
	}

	.blog-neu :global(.card__image) {
		display: block;
		width: 100%;
		height: 200px;
		flex-shrink: 0;
		object-fit: cover;
		box-shadow: inset 0 -4px 12px rgba(0, 0, 0, 0.06);
	}

	.blog-neu :global(.card__body) {
		padding: 1.25rem 1.35rem 1.35rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		flex: 1;
		min-height: 0;
		overflow: hidden;
		background: var(--neu-surface);
		box-shadow:
			inset 0 4px 10px var(--neu-dark),
			inset 0 -2px 8px var(--neu-light);
	}

	.blog-neu :global(.card__date) {
		margin: 0;
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--neu-muted);
	}

	.blog-neu :global(.card__title) {
		margin: 0;
		line-height: 1.3;
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--neu-text);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.blog-neu :global(.card__description) {
		margin: 0;
		color: var(--neu-muted);
		font-size: 0.95rem;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	@media (max-width: 640px) {
		.blog-neu__header {
			flex-direction: column;
			padding: 1.5rem;
		}
		.blog-neu :global(.post-grid) {
			grid-template-columns: 1fr;
		}
	}
</style>
