---
import AiBotChatInit from './AiBotChatInit.astro';
import AiBotSiteTab from './AiBotSiteTab.astro';
---

<div class="aibot">
	<header class="aibot__header">
		<a href="/" class="aibot__logo" aria-label="Back to site">
			<svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
				<path fill="#4285F4" d="M12 2l2.2 6.8H21l-5.5 4.2 2.1 6.5L12 15.5 6.4 19.5l2.1-6.5L3 8.8h6.8z"/>
				<path fill="#9B72CB" d="M12 6l1 3h3l-2.5 2 1 3L12 13l-2.5 2 1-3L8 9h3z" opacity=".85"/>
			</svg>
			<span>AI Bot</span>
		</a>
	</header>

	<div class="aibot__body">
		<main class="aibot__scroll" id="aibot-scroll">
			<div class="aibot__home" id="aibot-home">
				<h1 class="aibot__title">Ready when you are</h1>
			</div>
			<div class="aibot__chat" id="aibot-chat" hidden></div>
		</main>

		<footer class="aibot__footer">
			<AiBotSiteTab target="page" />
			<form class="aibot__composer" id="aibot-form">
				<button type="button" class="aibot__composer-btn" aria-label="Add">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M12 5v14M5 12h14"/>
					</svg>
				</button>
				<input
					type="text"
					id="aibot-input"
					class="aibot__input"
					placeholder="Ask AI Bot"
					autocomplete="off"
					aria-label="Message"
				/>
				<div class="aibot__composer-end">
					<button type="button" class="aibot__model" aria-haspopup="listbox">
						Flash
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<polyline points="6 9 12 15 18 9"/>
						</svg>
					</button>
					<button type="button" class="aibot__composer-btn" aria-label="Voice input">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/>
							<path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
							<line x1="12" y1="19" x2="12" y2="22"/>
						</svg>
					</button>
				</div>
			</form>
		</footer>
	</div>
</div>

<script>
	const form = document.getElementById('aibot-form');
	const input = document.getElementById('aibot-input') as HTMLInputElement | null;
	const home = document.getElementById('aibot-home');
	const chat = document.getElementById('aibot-chat');
	const scroll = document.getElementById('aibot-scroll');

	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		const text = input?.value.trim();
		if (!text || !chat || !home) return;

		home.hidden = true;
		chat.hidden = false;

		const user = document.createElement('p');
		user.className = 'aibot-msg aibot-msg--user';
		user.textContent = text;
		chat.appendChild(user);

		const bot = document.createElement('p');
		bot.className = 'aibot-msg aibot-msg--bot';
		bot.textContent = 'UI demo only — no AI connected yet.';
		chat.appendChild(bot);

		scroll?.scrollTo({ top: scroll.scrollHeight, behavior: 'smooth' });
		if (input) input.value = '';
	});
</script>

<AiBotChatInit />

<style>
	.aibot {
		--text: #1f1f1f;
		--muted: #5f6368;
		--composer-bg: #fff;
		--composer-shadow: 0 2px 6px rgba(0, 0, 0, 0.06), 0 8px 24px rgba(0, 0, 0, 0.08);
		height: 100dvh;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: #fff;
		color: var(--text);
	}

	:global(:root.dark) .aibot {
		--text: #e3e3e3;
		--muted: #9aa0a6;
		--composer-bg: #282a2c;
		--composer-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
		background: #131314;
	}

	.aibot__header {
		flex-shrink: 0;
		padding: 1rem 1.25rem;
		z-index: 2;
	}

	.aibot__logo {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		color: var(--text);
		font-size: 1.1rem;
		font-weight: 500;
	}

	.aibot__body {
		position: relative;
		flex: 1;
		display: flex;
		flex-direction: column;
		min-height: 0;
	}

	/* Glow in content area above input */
	.aibot__body::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 45%;
		transform: translate(-50%, -50%);
		width: min(90vw, 720px);
		height: min(60vh, 480px);
		background: radial-gradient(
			ellipse at center,
			rgba(66, 133, 244, 0.14) 0%,
			rgba(147, 197, 253, 0.08) 40%,
			transparent 70%
		);
		pointer-events: none;
		z-index: 0;
	}
	:global(:root.dark) .aibot__body::before {
		background: radial-gradient(
			ellipse at center,
			rgba(66, 133, 244, 0.12) 0%,
			rgba(30, 58, 95, 0.2) 45%,
			transparent 70%
		);
	}

	.aibot__scroll {
		position: relative;
		z-index: 1;
		flex: 1;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 1rem 1.25rem;
		min-height: 0;
	}

	.aibot__home {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		max-width: 720px;
		min-height: min(50vh, 400px);
	}

	.aibot__home[hidden] {
		display: none !important;
	}

	.aibot__title {
		margin: 0;
		font-size: clamp(1.75rem, 4vw, 2.25rem);
		font-weight: 400;
		text-align: center;
		letter-spacing: -0.02em;
	}

	.aibot__chat {
		width: 100%;
		max-width: 720px;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		padding: 0.5rem 0 1rem;
		flex: 1;
	}
	.aibot__chat[hidden] {
		display: none !important;
	}

	:global(.aibot-msg) {
		margin: 0;
		font-size: 1rem;
		line-height: 1.6;
	}
	:global(.aibot-msg--user) {
		align-self: flex-end;
		max-width: 85%;
		padding: 0.75rem 1rem;
		border-radius: 1.25rem;
		background: #f0f4f9;
		color: var(--text);
	}
	:global(:root.dark .aibot-msg--user) {
		background: #282a2c;
	}
	:global(.aibot-msg--bot) {
		align-self: flex-start;
		max-width: 90%;
		color: var(--text);
	}

	.aibot__footer {
		position: relative;
		z-index: 2;
		flex-shrink: 0;
		padding: 0.75rem 1.25rem 1.25rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		background: linear-gradient(to top, #fff 70%, transparent);
	}
	:global(:root.dark) .aibot__footer {
		background: linear-gradient(to top, #131314 70%, transparent);
	}

	.aibot__composer {
		display: flex;
		align-items: center;
		width: 100%;
		max-width: 720px;
		padding: 0.35rem 0.5rem 0.35rem 0.35rem;
		border-radius: 1.75rem;
		background: var(--composer-bg);
		box-shadow: var(--composer-shadow);
		border: 1px solid rgba(0, 0, 0, 0.04);
	}
	:global(:root.dark) .aibot__composer {
		border-color: rgba(255, 255, 255, 0.08);
	}

	.aibot__composer-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		flex-shrink: 0;
		border: none;
		border-radius: 50%;
		background: transparent;
		color: var(--muted);
		cursor: pointer;
	}
	.aibot__composer-btn:hover {
		background: rgba(0, 0, 0, 0.05);
	}
	:global(:root.dark) .aibot__composer-btn:hover {
		background: rgba(255, 255, 255, 0.08);
	}

	.aibot__input {
		flex: 1;
		min-width: 0;
		border: none;
		background: transparent;
		font: inherit;
		font-size: 1rem;
		color: var(--text);
		padding: 0.85rem 0.5rem;
	}
	.aibot__input:focus {
		outline: none;
	}
	.aibot__input::placeholder {
		color: var(--muted);
	}

	.aibot__composer-end {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		flex-shrink: 0;
	}

	.aibot__model {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		padding: 0.4rem 0.65rem;
		border: none;
		border-radius: 0.5rem;
		background: transparent;
		color: var(--muted);
		font: inherit;
		font-size: 0.875rem;
		font-weight: 500;
		cursor: pointer;
	}
	.aibot__model:hover {
		background: rgba(0, 0, 0, 0.05);
	}
	:global(:root.dark) .aibot__model:hover {
		background: rgba(255, 255, 255, 0.08);
	}
</style>
