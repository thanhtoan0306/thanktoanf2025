---
import HomeNeu from '../components/home/HomeNeu.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<HomeNeu />
</PageLayout>

<style>
	:global(body:has(.home-neu)) {
		background: #e4eaf3 !important;
		background-image: none !important;
	}

	:global(:root.dark body:has(.home-neu)) {
		background: #141a24 !important;
	}

	:global(body:has(.home-neu) header) {
		background: rgba(232, 237, 244, 0.75);
		backdrop-filter: blur(12px);
		box-shadow:
			0 4px 16px rgba(163, 177, 198, 0.2),
			inset 0 -1px 0 rgba(255, 255, 255, 0.6);
		border-bottom: none;
	}

	:global(:root.dark body:has(.home-neu) header) {
		background: rgba(20, 26, 36, 0.85);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
	}

	:global(body:has(.home-neu) header nav a) {
		border-bottom: none;
		border-radius: 999px;
		padding: 0.5em 0.85em;
		transition: box-shadow 0.15s ease, background 0.15s ease;
	}

	:global(body:has(.home-neu) header nav a.active) {
		background: #e8edf4;
		box-shadow:
			inset 3px 3px 8px #b8c3d6,
			inset -3px -3px 8px #ffffff;
		color: var(--accent);
	}

	:global(:root.dark body:has(.home-neu) header nav a.active) {
		background: #1a2230;
		box-shadow:
			inset 3px 3px 8px #0c1018,
			inset -3px -3px 8px #243044;
	}

	:global(body:has(.home-neu) header h2 a) {
		font-weight: 800;
		letter-spacing: -0.02em;
	}

	:global(body:has(.home-neu) .header-right .theme-switcher),
	:global(body:has(.home-neu) .social-links a) {
		border-radius: 50%;
		padding: 0.35rem;
		box-shadow:
			4px 4px 10px #b8c3d6,
			-4px -4px 10px #ffffff;
		background: #e8edf4;
	}

	:global(:root.dark body:has(.home-neu) .header-right .theme-switcher),
	:global(:root.dark body:has(.home-neu) .social-links a) {
		background: #1a2230;
		box-shadow:
			4px 4px 10px #0c1018,
			-4px -4px 10px #243044;
	}

	:global(body:has(.home-neu) footer) {
		background: transparent;
		background-image: none;
		padding-bottom: 2rem;
	}

	:global(body:has(.home-neu) footer .social-links a) {
		border-radius: 50%;
		padding: 0.5rem;
		background: #e8edf4;
		box-shadow:
			6px 6px 14px #b8c3d6,
			-6px -6px 14px #ffffff;
		transition: transform 0.15s ease;
	}

	:global(body:has(.home-neu) footer .social-links a:hover) {
		transform: translateY(-2px);
	}

	:global(:root.dark body:has(.home-neu) footer .social-links a) {
		background: #1a2230;
		box-shadow:
			6px 6px 14px #0c1018,
			-6px -6px 14px #243044;
	}

	:global(body:has(.home-neu) .page) {
		width: 100%;
		max-width: none;
		padding: 0;
	}
</style>
