---
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout title="Dashboard">
	<section class="dashboard">
		<h1>Dashboard</h1>
		<p class="lead">Private admin area. Only visible after login.</p>
	</section>

	<script>
		const DASHBOARD_ACCESS_KEY = 'dashboardAccess';
		const hasAccess =
			typeof window !== 'undefined' &&
			window.localStorage.getItem(DASHBOARD_ACCESS_KEY) === 'true';

		if (!hasAccess) {
			const next = encodeURIComponent('/admin');
			window.location.replace(`/login?next=${next}`);
		}
	</script>

	<style>
		.dashboard {
			max-width: 720px;
			margin: 0 auto;
			padding-top: 2rem;
		}
		.dashboard h1 {
			margin: 0 0 0.75rem 0;
			font-size: 2rem;
			font-weight: 700;
		}
		.lead {
			margin: 0;
			color: rgb(var(--gray));
		}
	</style>
</PageLayout>

